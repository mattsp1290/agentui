{
  "name": "@agentui/sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "import": "./dist/tools.js"
    },
    "./react-tools": {
      "types": "./dist/react-tools.d.ts",
      "import": "./dist/react-tools.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.react.json && tsc -p tsconfig.tools.json && tsc -p tsconfig.react-tools.json",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.react.json --noEmit && tsc -p tsconfig.tools.json --noEmit && tsc -p tsconfig.react-tools.json --noEmit"
  },
  "dependencies": {
    "@agentui/contracts": "0.0.0",
    "@agentui/protocol": "0.0.0",
    "@cfworker/json-schema": "4.1.6"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "react": "19.3.1"
  }
}
