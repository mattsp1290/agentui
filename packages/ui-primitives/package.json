{
  "name": "@agentui/ui-primitives",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./desktop": { "types": "./dist/desktop.d.ts", "import": "./dist/desktop.js" },
    "./native": { "types": "./dist/native.d.ts", "import": "./dist/native.js" },
    "./styles.css": "./src/styles.css"
  },
  "files": ["dist", "src/styles.css"],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.native.json",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.native.json --noEmit"
  },
  "dependencies": { "@agentui/theme": "0.0.0" },
  "peerDependencies": { "react": "^19.3.0", "react-native": "0.86.0" },
  "peerDependenciesMeta": { "react-native": { "optional": true } },
  "devDependencies": { "@types/react": "19.3.0", "react": "19.3.1", "react-native": "0.86.0" }
}
