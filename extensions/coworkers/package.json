{
  "name": "agentui-extension-coworkers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./server": "./dist/server.js",
    "./provider": "./dist/provider.js",
    "./client": "./dist/client.js",
    "./poller": "./dist/poller.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.desktop.json"
  },
  "dependencies": {
    "@agentui/contracts": "0.0.0",
    "@agentui/sdk": "0.0.0",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "@agentui/theme": "0.0.0",
    "@agentui/ui-primitives": "0.0.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "@agentui/theme": { "optional": true },
    "@agentui/ui-primitives": { "optional": true }
  },
  "agentui": {
    "extension": {
      "namespace": "coworkers",
      "trust": "full",
      "sdkVersion": "0.14.0",
      "entries": [
        { "kind": "server", "module": "./dist/server.js" },
        { "kind": "desktop", "module": "./dist/desktop.js" }
      ]
    },
    "sources": {
      "./dist/desktop.js": "./src/desktop/index.tsx",
      "./dist/server.js": "./src/server.ts"
    }
  }
}
