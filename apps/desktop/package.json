{
  "name": "@agentui/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev:web": "vite",
    "tauri:dev": "tauri dev",
    "tauri:bundle": "tauri build --bundles app",
    "build:browser": "vite build --mode browser && node ../../scripts/artifact-manifest.mjs browser-development"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@agentui/contracts": "0.0.0",
    "@agentui/sdk": "0.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@agentui/ui-primitives": "0.0.0",
    "@agentui/client": "0.0.0",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@tauri-apps/cli": "2.12.4",
    "vite": "8.3.8"
  }
}
