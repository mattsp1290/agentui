#!/bin/sh
set -eu

export PATH="/usr/bin:/bin:/usr/sbin:/sbin:$PATH"
if [ "$(uname -s)" != Darwin ]; then
  printf '%s\n' 'AgentUI requires macOS.' >&2
  exit 1
fi

repo_root=$(CDPATH='' cd -P "$(dirname "$0")" && pwd)
cd "$repo_root"
node_package="node@$(cat .node-version)"
npm_package=$(node -p "require('./package.json').packageManager")
export CARGO_TARGET_DIR="$repo_root/apps/desktop/src-tauri/target"

npm exec --yes --package="$node_package" --package="$npm_package" --call 'npm ci && npm run desktop:bundle'
exec /usr/bin/open -n "$CARGO_TARGET_DIR/release/bundle/macos/AgentUI.app" --args "$@"
