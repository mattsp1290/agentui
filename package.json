{
  "name": "agentui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24.22.3 <25",
    "npm": "11.19.1"
  },
  "workspaces": [
    "packages/contracts",
    "packages/sdk",
    "packages/theme",
    "packages/ui-primitives",
    "packages/host",
    "apps/desktop",
    "apps/ios",
    "packages/adapter-tests"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && npm run build --workspaces",
    "check": "npm run check --workspaces",
    "lint": "oxlint --deny-warnings packages apps scripts tests",
    "test": "node --test packages/adapter-tests/tests/*.test.mjs tests/theme/*.test.mjs tests/desktop/shell/*.test.mjs",
    "verify": "npm run build && npm run check && npm run lint && npm test",
    "preview:theme": "node tests/theme/preview.mjs",
    "setup:browser": "playwright install --with-deps chromium",
    "desktop:prepare": "npm run build --workspace=@agentui/contracts --workspace=@agentui/sdk --workspace=@agentui/theme --workspace=@agentui/ui-primitives",
    "desktop:build": "npm run desktop:prepare && npm run build --workspace=@agentui/desktop",
    "desktop:dev": "npm run tauri:dev --workspace=@agentui/desktop",
    "desktop:bundle": "npm run tauri:bundle --workspace=@agentui/desktop",
    "ios:prepare": "bash apps/ios/native/prepare.sh",
    "ios:run": "bash apps/ios/native/run.sh",
    "ios:verify": "bash apps/ios/native/verify.sh"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "axe-core": "4.14.0",
    "esbuild": "0.28.2",
    "oxlint": "1.93.0",
    "playwright": "1.65.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2"
  }
}
